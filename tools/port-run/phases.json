{
  "schema": 1,
  "base_branch": "main",
  "timeout_s": 5400,
  "common": {
    "allowed_tools": [
      "Read", "Edit", "Write", "Glob", "Grep", "Agent",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git mv:*)", "Bash(git rm:*)",
      "Bash(git diff:*)", "Bash(git status:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(bash tests/*)", "Bash(bash scripts/*)", "Bash(bash tools/port-run/ledger-check.sh)",
      "Bash(shellcheck:*)", "Bash(python3:*)", "Bash(jq:*)", "Bash(claude plugin validate:*)"
    ],
    "disallowed_tools": [
      "Bash(git push:*)", "Bash(gh:*)", "Bash(rm -rf:*)", "Bash(brew:*)", "Bash(npm install -g:*)",
      "Bash(claude plugin install:*)", "Bash(claude plugin marketplace:*)", "Bash(git config --global:*)"
    ],
    "dod": [
      "claude plugin validate plugin --strict",
      "bash tools/port-run/ledger-check.sh",
      "bash tests/lint/no-hardcode.sh",
      "bash plugin/scripts/test-commit-msg-check.sh"
    ]
  },
