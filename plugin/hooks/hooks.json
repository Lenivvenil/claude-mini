{
  "description": "Conventional Commits check for git commit, only in projects where the plugin is enabled",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/commit-msg-check.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
