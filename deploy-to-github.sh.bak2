#!/usr/bin/env bash
# deploy-to-github.sh — создаёт Lenivvenil/claude-mini private и заливает содержимое.
#
# Предусловия:
#   • Запускается из директории, в которую распакован claude-mini.tar.gz
#   • gh CLI установлен и аутентифицирован под Lenivvenil (gh auth status)
#   • git установлен и настроен (user.name, user.email)
#   • Директория НЕ является уже git-репозиторием под другим remote
#
# Что делает:
#   1. Инициализирует git (если ещё нет)
#   2. Создаёт Lenivvenil/claude-mini private через gh repo create
#   3. Initial commit + push main
#   4. Создаёт канонические labels
#   5. Создаёт 3 milestones: M0, M1, M2
#
# Идемпотентность: повторный запуск не падает, пропускает уже сделанное.
#
# Использование:
#   ./deploy-to-github.sh [--dry-run]

set -euo pipefail

OWNER="Lenivvenil"
REPO="claude-mini"
FULL="${OWNER}/${REPO}"
DRY_RUN=false

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        *) echo "Unknown arg: $arg"; exit 1 ;;
    esac
done

say() { printf "\033[1;34m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m!!\033[0m %s\n" "$*" >&2; }
die() { printf "\033[1;31mXX\033[0m %s\n" "$*" >&2; exit 1; }

run() {
    if $DRY_RUN; then
        printf "\033[1;90m(dry)\033[0m %s\n" "$*"
    else
        eval "$@"
    fi
}

# --- 0. Preflight ---

say "Preflight checks"

command -v gh >/dev/null || die "gh CLI не найден. Установи: brew install gh"
command -v git >/dev/null || die "git не найден"
gh auth status >/dev/null 2>&1 || die "gh не аутентифицирован. Запусти: gh auth login"

CURRENT_USER=$(gh api user --jq .login 2>/dev/null)
if [ "$CURRENT_USER" != "$OWNER" ]; then
    warn "gh аутентифицирован как '$CURRENT_USER', а не '$OWNER'"
    warn "Если это правильно (другой аккаунт для этого владельца) — продолжаем; иначе Ctrl+C"
    read -p "Продолжить? [y/N] " ans
    [ "$ans" = "y" ] || [ "$ans" = "Y" ] || exit 1
fi

[ -f README.md ] || die "Нет README.md в текущей директории. Запусти скрипт из корня распакованного проекта."
[ -d docs/decisions ] || die "Нет docs/decisions/. Неверная директория?"
[ -d bootstrap/agents ] || die "Нет bootstrap/agents/. Неверная директория?"

# --- 1. Init git ---

if [ -d .git ]; then
    say "Git уже инициализирован — пропускаем git init"
    EXISTING_REMOTE=$(git remote get-url origin 2>/dev/null || echo "")
    if [ -n "$EXISTING_REMOTE" ]; then
        warn "Remote origin уже установлен на: $EXISTING_REMOTE"
        warn "Если это не ${FULL} — исправь руками или удали .git и перезапусти"
    fi
else
    say "git init"
    run git init
    run git branch -M main
fi

# --- 2. Create repo ---

if gh repo view "$FULL" >/dev/null 2>&1; then
    say "Репо ${FULL} уже существует — пропускаем создание"
else
    say "Создаю ${FULL} как private"
    run gh repo create "$FULL" \
        --private \
        --description "Personal AI-assisted dev pipeline with reproducible Claude Code workflow" \
        --source=. \
        --remote=origin
fi

# --- 3. Initial commit + push ---

# Fetch to detect if remote has commits
git fetch origin 2>/dev/null || true

if git rev-parse --verify HEAD >/dev/null 2>&1; then
    say "Локальные коммиты уже есть — пропускаем initial commit"
else
    if git ls-remote --exit-code origin main >/dev/null 2>&1; then
        warn "Remote main уже имеет коммиты, локальный репо пустой"
        warn "Делаю pull, чтобы не потерять remote state"
        run git pull origin main --allow-unrelated-histories
    fi

    # Если всё ещё нет HEAD — делаем initial
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
        say "Initial commit"
        run git add .
        run git commit -m "chore: initial bootstrap from claude-mini meta-design"
    fi
fi

if $DRY_RUN; then
    say "(dry) skipping push"
else
    if git ls-remote --exit-code origin main >/dev/null 2>&1; then
        # Remote уже имеет main — проверяем, всё ли запушено
        if ! git diff --quiet HEAD origin/main 2>/dev/null; then
            say "Push (updates exist)"
            git push origin main
        else
            say "Remote и local main совпадают — push не нужен"
        fi
    else
        say "Push main в origin"
        git push -u origin main
    fi
fi

# --- 4. Labels ---

say "Создаю канонические labels"

create_label() {
    local name="$1" color="$2" desc="$3"
    if gh label list --repo "$FULL" --json name --jq '.[].name' 2>/dev/null | grep -qFx "$name"; then
        echo "  · $name (exists)"
    else
        run gh label create "$name" --repo "$FULL" --color "$color" --description "$desc" 2>/dev/null && echo "  + $name" || echo "  ! $name (failed)"
    fi
}

# Triage / lifecycle
create_label "needs-triage"        "ededed" "Requires initial triage"
create_label "blocked"             "b60205" "Blocked by dependency / external"
create_label "duplicate"           "cfd3d7" "Duplicate issue"

# Types
create_label "type:adr"            "0e8a16" "Architecture Decision Record"
create_label "type:feature"        "1d76db" "New capability"
create_label "type:bug"            "d73a4a" "Defect"
create_label "type:epic"           "3d2b5e" "Epic / large body of work"
create_label "type:spike"          "c5def5" "Timeboxed research"
create_label "type:deferred-review" "fbca04" "Codex review skipped, graceful degradation"
create_label "type:runbook"        "5319e7" "Runbook / procedural docs"

# Priorities
create_label "P0-critical"         "b60205" "Drop everything"
create_label "P1-high"             "d93f0b" "This sprint"
create_label "P2-medium"           "fbca04" "Next sprint"
create_label "P3-low"              "c2e0c6" "When we get to it"

# Estimates (Fibonacci)
create_label "estimate/1"          "c2e0c6" "Trivial — under 1h"
create_label "estimate/2"          "c2e0c6" "Quick — few hours"
create_label "estimate/3"          "c2e0c6" "Half day"
create_label "estimate/5"          "fef2c0" "Full day"
create_label "estimate/8"          "fef2c0" "2-3 days"
create_label "estimate/13"         "f9d0c4" "A week or more — consider splitting"

# Areas / flags
create_label "area:agents"         "5319e7" ""
create_label "area:commands"       "5319e7" ""
create_label "area:skills"         "5319e7" ""
create_label "area:hooks"          "5319e7" ""
create_label "area:governance"     "5319e7" ""
create_label "area:docs"           "5319e7" ""
create_label "area:ci"             "5319e7" ""
create_label "area:bootstrap"      "5319e7" ""
create_label "adr-needed"          "d4c5f9" "Architectural decision required"
create_label "security"            "b60205" "Security-sensitive"

# --- 5. Milestones ---

say "Создаю milestones"

create_milestone() {
    local title="$1" due="$2" desc="$3"
    # gh не имеет нативной команды для milestones — через REST API
    if gh api "repos/${FULL}/milestones?state=all" --jq '.[].title' 2>/dev/null | grep -qFx "$title"; then
        echo "  · $title (exists)"
    else
        if $DRY_RUN; then
            echo "  (dry) + $title"
        else
            gh api "repos/${FULL}/milestones" \
                -f title="$title" \
                -f description="$desc" \
                -f due_on="$due" \
                --silent 2>/dev/null && echo "  + $title" || echo "  ! $title (failed)"
        fi
    fi
}

# Даты в будущее; даты можно менять руками позже через UI
create_milestone "M0: baseline verified" \
    "2026-05-05T23:59:59Z" \
    "Universal setup проверен идемпотентным; governance hook заблокировал плохой commit; все 6 агентов/10 команд/3 скилла реально установлены на mini."

create_milestone "M1: pipeline proven on real project" \
    "2026-05-19T23:59:59Z" \
    "Первая задача прошла полный pipeline end-to-end; runbook onboarding-repo обогащён практикой; weekly /project-health ритуал установлен; two-voice review поймал реальный miss."

create_milestone "M2: enforcement hardened" \
    "2026-06-16T23:59:59Z" \
    "Phase 2 governance (git-level commit-msg hook); CI workflow валидирован на живом проекте; domain/ наполнен; incident-recovery проверен на реальном инциденте."

say "Готово"
echo
echo "Repo:     https://github.com/${FULL}"
echo "Labels:   https://github.com/${FULL}/labels"
echo "Milestones: https://github.com/${FULL}/milestones"
echo
echo "Следующий шаг: ./create-backlog.sh  (создаст 12 initial issues)"
